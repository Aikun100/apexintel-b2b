# ==============================================================================
# ApexIntel B2B - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit real secrets to Git.

# Application Environment
NODE_ENV=development
PORT=3000

# AWS Configuration (Region: ap-southeast-2)
AWS_REGION=ap-southeast-2
AWS_PROFILE=apexintel

# DynamoDB Table Names
DYNAMODB_USERS_TABLE=apexintel_users
DYNAMODB_SESSIONS_TABLE=apexintel_sessions
DYNAMODB_RATE_LIMITS_TABLE=apexintel_rate_limits
DYNAMODB_RESETS_TABLE=apexintel_password_resets

# Mock Storage (set to true for offline development without active AWS credentials)
USE_MOCK_STORAGE=true

# Allowed Origins (CORS & CSRF Defense)
ALLOWED_ORIGINS=https://apexintel-b2b.shop,https://www.apexintel-b2b.shop,http://localhost:3000,http://127.0.0.1:3000

# Cloudflare Worker Environment Variables (configured via wrangler secret put)
# BACKEND_AUTH_URL=https://auth.apexintel-b2b.shop
# AWS_LAMBDA_AUTH_URL=https://xxxxxxxxxx.lambda-url.ap-southeast-2.on.aws/
