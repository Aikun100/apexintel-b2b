{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBLeadsCacheTableOperations",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-2:129264592603:table/leads_cache",
        "arn:aws:dynamodb:ap-southeast-2:129264592603:table/leads_cache/index/trade-createdAt-index",
        "arn:aws:dynamodb:ap-southeast-2:129264592603:table/leads_cache/index/city-createdAt-index"
      ]
    },
    {
      "Sid": "DynamoDBSessionAndUserReadForAdminAuthCheck",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-southeast-2:129264592603:table/apexintel_sessions",
        "arn:aws:dynamodb:ap-southeast-2:129264592603:table/apexintel_users"
      ]
    },
    {
      "Sid": "CloudWatchLogGroupCreation",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:129264592603:*"
    },
    {
      "Sid": "CloudWatchLogStreamAndEvents",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-southeast-2:129264592603:log-group:/aws/lambda/apexintel-crawler:*",
        "arn:aws:logs:ap-southeast-2:129264592603:log-group:/aws/lambda/apexintel-discovery:*"
      ]
    }
  ]
}
